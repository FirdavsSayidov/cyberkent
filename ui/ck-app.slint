        }
    }

    if root.overlay == CkOverlay.product: ProductDetailPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
        buy => {
            if (!root.gated("Xarid qilish uchun ro'yxatdan o'ting.")) {
                root.pending-price = self.price-value;
                root.push(CkOverlay.payment-qr);
            }
        }
    }

    if root.overlay == CkOverlay.payment-qr: PaymentQrPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
        paid => {
            // To'lov tasdiqlandi — CyberAqcha balansdan yechiladi.
            Store.buy(root.pending-price);
            root.overlay-from = CkOverlay.none;
            root.overlay = CkOverlay.order-success;
        }
    }

    if root.overlay == CkOverlay.orders: OrdersPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
        order-clicked(index) => {
            root.push(CkOverlay.order-detail);
        }
        action-clicked(index) => {
            root.push(CkOverlay.payment-qr);
        }
    }

    if root.overlay == CkOverlay.order-detail: OrderDetailPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
    }

    if root.overlay == CkOverlay.order-success: OrderSuccessPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        to-orders => {
            root.overlay-from = CkOverlay.none;
            root.overlay = CkOverlay.orders;
        }
        to-shop => {
            root.overlay-from = CkOverlay.none;
            root.overlay = CkOverlay.none;
            root.page = 3;
        }
    }

    if root.overlay == CkOverlay.tx-history: TxHistoryPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
