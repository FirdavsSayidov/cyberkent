        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
    }

    if root.overlay == CkOverlay.settings: SettingsPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
        item-clicked(index) => {
            // Til, mavzu va intensivlik sozlamalari qurilma xotirasini talab
            // qiladi — bu sof UI portida ular o'z ekranida ko'rsatiladi.
            if (index == 99) {
                root.to-entry();
            }
        }
    }

    if root.overlay == CkOverlay.news: NewsPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
    }

    if root.overlay == CkOverlay.notifications: NotificationsPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
    }

    // ── CYBERQUIZ ──────────────────────────────────────────────────────────

    if root.overlay == CkOverlay.quiz: QuizPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
        scan => {
            root.push(CkOverlay.quiz-scan);
        }
        tests => {
            root.push(CkOverlay.quiz-tests);
        }
    }

    if root.overlay == CkOverlay.quiz-tests: QuizTestsPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
        create => {
            root.push(CkOverlay.quiz-editor);
        }
        test-clicked(index) => {
            root.push(CkOverlay.quiz-editor);
        }
    }

    if root.overlay == CkOverlay.quiz-editor: QuizEditorPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.close-overlay();
        }
        saved => {
            root.close-overlay();
        }
    }

    if root.overlay == CkOverlay.quiz-scan: QuizScanPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        active: root.overlay == CkOverlay.quiz-scan;
        back => {
            root.close-overlay();
        }
        joined => {
            root.overlay-from = CkOverlay.quiz;
            root.overlay = CkOverlay.quiz-result;
        }
    }

    if root.overlay == CkOverlay.quiz-result: QuizResultPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        done => {
            root.close-overlay();
        }
    }

    // ═══ TEKSHIRUVCHI ══════════════════════════════════════════════════════

    if root.phase == CkPhase.inspector-login: InspectorLoginPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.phase = CkPhase.roles;
        }
        success => {
            root.phase = CkPhase.inspector;
            root.insp = CkInsp.home;
        }
    }

    if root.phase == CkPhase.inspector: InspectorHomePage {
        width: root.width;
        height: root.height;
        active: root.phase == CkPhase.inspector && root.insp == CkInsp.home;
        visible: root.insp == CkInsp.home;
        scan => {
            root.insp = CkInsp.scan;
        }
        visitors => {
            root.insp = CkInsp.visitors;
        }
        sign-out => {
            root.to-entry();
        }
    }

    if root.phase == CkPhase.inspector && root.insp == CkInsp.scan: InspectorScanPage {
        width: root.width;
        height: root.height;
        active: root.insp == CkInsp.scan;
        back => {
            root.insp = CkInsp.home;
        }
        detected => {
            root.insp = CkInsp.result;
        }
    }

    if root.phase == CkPhase.inspector && root.insp == CkInsp.result: ScanResultPage {
        width: root.width;
        height: root.height;
        back => {
            root.insp = CkInsp.scan;
        }
        approve => {
            root.insp = CkInsp.success;
        }
        reject => {
            root.insp = CkInsp.rejected;
        }
    }

    if root.phase == CkPhase.inspector && root.insp == CkInsp.success: CheckInSuccessPage {
        width: root.width;
        height: root.height;
        active: root.insp == CkInsp.success;
        done => {
            root.insp = CkInsp.home;
        }
    }

    if root.phase == CkPhase.inspector && root.insp == CkInsp.rejected: CheckInRejectedPage {
        width: root.width;
        height: root.height;
        done => {
            root.insp = CkInsp.home;
        }
    }

    if root.phase == CkPhase.inspector && root.insp == CkInsp.visitors: VisitorsListPage {
        width: root.width;
        height: root.height;
        back => {
            root.insp = CkInsp.home;
        }
    }

    // ═══ SOTUVCHI ══════════════════════════════════════════════════════════
    //
    // To'rt tab: BUYURTMALAR · SKANER · SOTUVLAR · QOLDIQ. Ikkinchisi sahifa
    // emas — skanerni ochadi va yopilganda birinchi tabga qaytadi.

    property <bool> sell-tabs: root.phase == CkPhase.seller && root.sell == CkSell.none;

    if root.phase == CkPhase.seller-login: SellerLoginPage {
        width: root.width;
        height: root.height;
        // Silliq kirish: slaydli + so'nuvchi (Flutter route o'tishiga o'xshash).
        property <bool> ck-in: false;
        init => { self.ck-in = true; }
        opacity: ck-in ? 1.0 : 0.0;
        y: ck-in ? 0 : 16px;
        animate opacity, y { duration: 260ms; easing: ease-out-quint; }
        back => {
            root.phase = CkPhase.roles;
        }
        success => {
            root.phase = CkPhase.seller;
            root.sell-tab = 0;
            root.sell = CkSell.none;
        }
    }

    if root.phase == CkPhase.seller: SellerOrdersPage {
        width: root.width;
        height: root.height;
        opacity: (root.sell-tabs && root.sell-tab == 0) ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        active: root.sell-tabs && root.sell-tab == 0;
        animate opacity { duration: 200ms; easing: ease-out-quint; }

        sign-out => {
            root.to-entry();
        }
        order-clicked(index) => {
            root.sell = CkSell.scanner;
        }
    }

    if root.phase == CkPhase.seller: SellerSalesPage {
        width: root.width;
        height: root.height;
        opacity: (root.sell-tabs && root.sell-tab == 2) ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        active: root.sell-tabs && root.sell-tab == 2;
        animate opacity { duration: 200ms; easing: ease-out-quint; }
    }

    if root.phase == CkPhase.seller: SellerStockPage {
        width: root.width;
        height: root.height;
        opacity: (root.sell-tabs && root.sell-tab == 3) ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        active: root.sell-tabs && root.sell-tab == 3;
        animate opacity { duration: 200ms; easing: ease-out-quint; }
    }

    if root.phase == CkPhase.seller && root.sell == CkSell.scanner: SellerScannerPage {
        width: root.width;
        height: root.height;
        active: root.sell == CkSell.scanner;
        back => {
            root.sell = CkSell.none;
            root.sell-tab = 0;
        }
        confirmed => {
            root.sell = CkSell.completed;
        }
    }

    if root.phase == CkPhase.seller && root.sell == CkSell.completed: SellerCompletedPage {
        width: root.width;
        height: root.height;
        active: root.sell == CkSell.completed;
        done => {
            root.sell = CkSell.none;
            root.sell-tab = 0;
        }
    }

    // Sotuvchi paneli. "SKANER" tabi sahifa almashtirmaydi — skanerni ochadi,
    // shuning uchun tanlov birinchi tabda qoladi.
    if root.phase == CkPhase.seller: CkTabBar {
        x: 12px;
        y: root.sell == CkSell.none
            ? root.height - self.height - 20px - Ck.safe-bottom
            : root.height + 10px;
        width: root.width - 24px;
        opacity: root.sell == CkSell.none ? 1.0 : 0.0;
        current: root.sell-tab;
        items: [
            { icon: CkIcons.ticket, label: "BUYURTMALAR", tint: #00e5ff },
            { icon: CkIcons.qr, label: "SKANER", tint: #00e5ff },
            { icon: CkIcons.trend, label: "SOTUVLAR", tint: #00e5ff },
            { icon: CkIcons.package, label: "QOLDIQ", tint: #00e5ff },
        ];
        animate y, opacity {
            duration: 260ms;
            easing: ease-out-quint;
        }

        changed current => {
            if (self.current == 1) {
                root.sell = CkSell.scanner;
                // Tanlov skaner tabida qolib ketmasin.
                self.current = root.sell-tab;
            } else {
                root.sell-tab = self.current;
            }
        }
    }

    // ═══ MEHMON UCHUN RO'YXAT OYNASI ═══════════════════════════════════════
    // Eng ustki qatlam: ishtirok talab qiladigan bo'lim bosilganda chiqadi.

    if root.gate-reason != "": GuestGateSheet {
        width: root.width;
        height: root.height;
        reason: root.gate-reason;
        dismissed => {
            root.gate-reason = "";
        }
        register => {
            root.gate-reason = "";
            root.overlay = CkOverlay.none;
            root.phase = CkPhase.register;
        }
        login => {
            root.gate-reason = "";
            root.overlay = CkOverlay.none;
            root.phase = CkPhase.login;
        }
    }
}
