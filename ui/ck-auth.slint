// ═══════════════════════════════════════════════════════════════════════════
// 01–04 — KIRISH OQIMI: Splash, Onboarding, Kirish, Ro'yxatdan o'tish
//
// Dizayndagi 04-ekran SMS kodini tasdiqlash edi. Buyurtmaga ko'ra OTP
// ishlatilmaydi, shuning uchun u oddiy ro'yxatdan o'tish shakliga
// almashtirildi — kod kutish bosqichi yo'q.
// ═══════════════════════════════════════════════════════════════════════════

import {
    Ck, CkIcons,
    CkIcon, CkIconSlot, CkBadge, CkLogo, CkCoin,
    CkPrimaryButton, CkSecondaryButton, CkGhostButton, CkField,
    CkProgress, CkCardFlat, CkDivider,
} from "ck-common.slint";

// ── 01 SPLASH ──────────────────────────────────────────────────────────────

export component SplashPage inherits Rectangle {
    background: transparent;

    in property <float> progress: 0.68;
    in property <string> status: "v1.0 · INITIALIZING SECURE LEDGER";

    VerticalLayout {
        padding-top: Ck.safe-top;
        padding-bottom: Ck.safe-bottom;

        // markazdagi logotip
        Rectangle {
            vertical-stretch: 1;

            // orqadagi binafsha nur
            Rectangle {
                width: 220px;
                height: 220px;
                background: @radial-gradient(circle, Ck.purple.transparentize(0.6) 0%, #00000000 70%);
            }

            VerticalLayout {
                alignment: center;
                spacing: 18px;

                HorizontalLayout {
                    alignment: center;
                    CkLogo {
                        size: 84px;
                    }
                }

                VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: "CYBERKENT";
                        color: #ffffff;
                        font-family: Ck.sans;
                        font-size: 28px;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "EVENT · WALLET · STREAM";
                        color: Ck.cyan;
                        font-family: Ck.mono;
                        font-size: 10px;
                        letter-spacing: 1.8px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 40px;
            spacing: 10px;

            Text {
                text: root.status;
                color: Ck.text-mute;
                font-family: Ck.mono;
                font-size: 11px;
                horizontal-alignment: center;
            }

            CkProgress {
                value: root.progress;
            }
        }
    }
}

// ── 02 ONBOARDING ──────────────────────────────────────────────────────────

export struct CkSlide {
    eyebrow: string,
    title: string,
    accent: string,
    body: string,
}

export component OnboardingPage inherits Rectangle {
    background: transparent;

    in property <[CkSlide]> slides: [
        {
            eyebrow: "01 / 03 — XUSH KELIBSIZ",
            title: "Tadbir, mukofot va",
            accent: "jonli stream — bitta joyda",
            body: "CyberKent — eng zo'r tadbirlarga yoziling, topshiriqlar bajaring va CyberAqcha to'plab cyber-do'kondan sovg'alar oling.",
        },
        {
            eyebrow: "02 / 03 — CYBERAQCHA",
            title: "Topshiriq bajaring,",
            accent: "aqcha ishlang",
            body: "Har bir tadbir, quiz va stream uchun CyberAqcha olasiz. Balansingiz secure ledger'da saqlanadi.",
        },
        {
            eyebrow: "03 / 03 — QR BILAN KIRISH",
            title: "Biletni telefoningizda",
            accent: "olib yuring",
            body: "Tadbirga yozilganingizdan keyin QR kod chiqadi — kirishda uni ko'rsatasiz, boshqa hech narsa kerak emas.",
        },
    ];

    in-out property <int> step: 0;

    callback skip();
    callback finished();

    private property <CkSlide> slide: root.slides[root.step];

    VerticalLayout {
        padding-top: Ck.safe-top;
        padding-bottom: Ck.safe-bottom;

        // ── yuqori qator ──
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 8px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                CkLogo {
                    size: 22px;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "CYBERKENT";
                    color: #ffffff;
                    font-family: Ck.sans;
                    font-size: 13px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                CkGhostButton {
                    text: "O'tkazib yuborish";
                    clicked => {
                        root.skip();
                    }
                }
            }
        }

        // ── markaz ──
        VerticalLayout {
            vertical-stretch: 1;
            padding-left: 20px;
            padding-right: 20px;
            alignment: center;
            spacing: 10px;

            // rasm o'rnidagi blok
            Rectangle {
                height: 240px;
                border-radius: Ck.r-lg;
                border-width: 1px;
                border-color: Ck.line-strong;
                background: Ck.bg1;
                clip: true;

                Rectangle {
                    x: parent.width * 0.3 - self.width / 2;
                    y: parent.height * 0.3 - self.height / 2;
                    width: parent.width * 1.2;
                    height: self.width;
                    background: @radial-gradient(circle, Ck.purple.transparentize(0.45) 0%, #00000000 60%);
                }

                Rectangle {
                    x: parent.width * 0.8 - self.width / 2;
                    y: parent.height * 1.0 - self.height / 2;
                    width: parent.width * 1.2;
                    height: self.width;
                    background: @radial-gradient(circle, Ck.cyan.transparentize(0.55) 0%, #00000000 60%);
                }

                // qiyshaygan tadbir kartasi
                Rectangle {
                    x: 24px;
                    y: 36px;
                    width: 140px;
                    height: 80px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #ffffff2e;
                    background: #ffffff12;
                    // dizaynda -6° qiyshaygan; Slint 1.17'da Rectangle
                    // aylantirilmaydi (rotation-angle faqat Image/Path'da)

                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        alignment: start;

                        Text {
                            text: "EVENT · 27 NOY";
                            color: Ck.cyan;
                            font-family: Ck.mono;
                            font-size: 9px;
                            letter-spacing: 1.4px;
                        }

                        Text {
                            text: "Cyber Summit 2024";
                            color: #ffffff;
                            font-family: Ck.sans;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }
                }

                // qiyshaygan hamyon kartasi
                Rectangle {
                    x: parent.width - self.width - 20px;
                    y: parent.height - self.height - 30px;
                    width: 130px;
                    height: 90px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #ffffff4d;
                    background: @linear-gradient(135deg, #00e5ff, #7c4dff);
                    // dizaynda 8° qiyshaygan — yuqoridagi sabab

                    VerticalLayout {
                        padding: 12px;
                        alignment: space-between;

                        Text {
                            text: "CYBERAQCHA";
                            color: Ck.bg1;
                            font-family: Ck.mono;
                            font-size: 9px;
                            letter-spacing: 1.5px;
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            alignment: start;
                            Text {
                                text: "1,250";
                                color: Ck.bg1;
                                font-family: Ck.sans;
                                font-size: 22px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                CkCoin { size: 18px; }
                            }
                        }
                    }
                }

                // QR katakchasi
                Rectangle {
                    x: 40px;
                    y: parent.height - self.height - 24px;
                    width: 70px;
                    height: 70px;
                    border-radius: Ck.r-md;
                    border-width: 1px;
                    border-color: Ck.line-strong;
                    background: Ck.bg2;

                    CkIcon {
                        commands: CkIcons.qr;
                        size: 36px;
                        tint: Ck.cyan;
                    }
                }
            }

            Text {
                text: root.slide.eyebrow;
                color: Ck.cyan;
                font-family: Ck.mono;
                font-size: 10px;
                letter-spacing: 1.8px;
            }

            Text {
                text: root.slide.title;
                color: Ck.text;
                font-family: Ck.sans;
                font-size: 26px;
                font-weight: 600;
                wrap: word-wrap;
            }

            Text {
                text: root.slide.accent;
                color: Ck.cyan;
                font-family: Ck.sans;
                font-size: 26px;
                font-weight: 600;
                wrap: word-wrap;
            }

            Text {
                text: root.slide.body;
                color: Ck.text-dim;
                font-family: Ck.sans;
                font-size: 14px;
                wrap: word-wrap;
            }
        }

        // ── pastki qator ──
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 30px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    for i in 3: Rectangle {
                        width: root.step == i ? 18px : 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: root.step == i ? Ck.cyan : Ck.line-strong;
                        animate width, background {
                            duration: 260ms;
                            easing: ease-out-quint;
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            CkPrimaryButton {
                text: root.step == 2 ? "Boshlash" : "Davom etish";
                icon: CkIcons.arrow-r;
                clicked => {
                    if (root.step == 2) {
                        root.finished();
                    } else {
                        root.step += 1;
                    }
                }
            }
        }
    }
}

// ── 03 KIRISH ──────────────────────────────────────────────────────────────

export component LoginPage inherits Rectangle {
    background: transparent;

    in-out property <string> email: "ali@cyberkent.uz";
    in-out property <string> password;
    in-out property <bool> remember: true;

    callback login();
    callback go-register();

    VerticalLayout {
        padding-top: Ck.safe-top;
        padding-bottom: Ck.safe-bottom;

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 24px;
            spacing: 6px;

            HorizontalLayout {
                alignment: start;
                padding-bottom: 12px;
                CkLogo {
                    size: 36px;
                }
            }

            Text {
                text: "SECURE ACCESS";
                color: Ck.cyan;
                font-family: Ck.mono;
                font-size: 10px;
                letter-spacing: 1.8px;
            }

            Text {
                text: "Kirish";
                color: Ck.text;
                font-family: Ck.sans;
                font-size: 28px;
                font-weight: 600;
            }

            Text {
                text: "CyberID hisobingizga kiring";
                color: Ck.text-dim;
                font-family: Ck.sans;
                font-size: 12px;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            padding: 20px;
            padding-top: 24px;
            spacing: 14px;
            alignment: start;

            CkField {
                label: "ELEKTRON POCHTA";
                placeholder: "siz@cyberkent.uz";
                text <=> root.email;
            }

            CkField {
                label: "PAROL";
                placeholder: "••••••••";
                password: true;
                text <=> root.password;
                accepted => {
                    root.login();
                }
            }

            // eslab qol + parolni unutdingizmi
            HorizontalLayout {
                padding-top: 2px;
                spacing: 8px;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Ck.line-strong;
                    background: root.remember ? Ck.cyan.transparentize(0.82) : transparent;

                    TouchArea {
                        clicked => {
                            root.remember = !root.remember;
                        }
                    }

                    if root.remember: CkIcon {
                        commands: CkIcons.check;
                        size: 12px;
                        tint: Ck.cyan;
                    }
                }

                Text {
                    text: "Eslab qol";
                    color: Ck.text-dim;
                    font-family: Ck.sans;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: "Parolni unutdingizmi?";
                    color: Ck.cyan;
                    font-family: Ck.sans;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            CkPrimaryButton {
                text: "Kirish";
                icon: CkIcons.shield;
                clicked => {
                    root.login();
                }
            }

            // ── YOKI ──
            HorizontalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    CkDivider { }
                }

                Text {
                    text: "YOKI";
                    color: Ck.text-mute;
                    font-family: Ck.mono;
                    font-size: 10px;
                    letter-spacing: 1.6px;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    CkDivider { }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                CkSecondaryButton {
                    horizontal-stretch: 1;
                    text: "OneID";
                    clicked => {
                        root.login();
                    }
                }

                CkSecondaryButton {
                    horizontal-stretch: 1;
                    text: "Google";
                    clicked => {
                        root.login();
                    }
                }
            }
        }

        HorizontalLayout {
            padding-bottom: 28px;
            alignment: center;
            spacing: 6px;

            Text {
                text: "Hisobingiz yo'qmi?";
                color: Ck.text-dim;
                font-family: Ck.sans;
                font-size: 13px;
            }

            Rectangle {
                width: reg.preferred-width;
                height: reg.preferred-height;

                TouchArea {
                    clicked => {
                        root.go-register();
                    }
                }

                reg := Text {
                    text: "Ro'yxatdan o'tish";
                    color: Ck.cyan;
                    font-family: Ck.sans;
                    font-size: 13px;
                    font-weight: 600;
                }
            }
        }
    }
}

// ── 04 RO'YXATDAN O'TISH ───────────────────────────────────────────────────

export component RegisterPage inherits Rectangle {
    background: transparent;

    in-out property <string> full-name;
    in-out property <string> phone;
    in-out property <string> email;
    in-out property <string> password;

    callback back();
    callback register();

    VerticalLayout {
        padding-top: Ck.safe-top;
        padding-bottom: Ck.safe-bottom;

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 8px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                CkSecondaryButton {
                    width: 36px;
                    height: 36px;
                    text: "‹";
                    clicked => {
                        root.back();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "YANGI CYBERID";
                    color: Ck.cyan;
                    font-family: Ck.mono;
                    font-size: 10px;
                    letter-spacing: 1.8px;
                }
            }
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 12px;
            spacing: 6px;

            Text {
                text: "Hisob yarating";
                color: Ck.text;
                font-family: Ck.sans;
                font-size: 28px;
                font-weight: 600;
            }

            Text {
                text: "Ma'lumotlaringiz secure ledger orqali tekshiriladi";
                color: Ck.text-dim;
                font-family: Ck.sans;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            padding: 20px;
            padding-top: 24px;
            spacing: 14px;
            alignment: start;

            CkField {
                label: "F.I.SH.";
                placeholder: "Aziz Bekmurodov";
                text <=> root.full-name;
            }

            CkField {
                label: "TELEFON RAQAMI";
                placeholder: "+998 90 123 45 67";
                text <=> root.phone;
            }

            CkField {
                label: "ELEKTRON POCHTA";
                placeholder: "siz@cyberkent.uz";
                text <=> root.email;
            }

            CkField {
                label: "PAROL";
                placeholder: "kamida 8 belgi";
                password: true;
                text <=> root.password;
                accepted => {
                    root.register();
                }
            }

            // xavfsizlik eslatmasi
            CkCardFlat {
                interactive: false;

                HorizontalLayout {
                    padding: 14px;
                    spacing: 10px;

                    CkIconSlot {
                        commands: CkIcons.shield;
                        size: 20px;
                        tint: Ck.mint;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;

                        Text {
                            text: "Identifikatsiya secure ledger orqali tekshiriladi";
                            color: Ck.text-dim;
                            font-family: Ck.sans;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        CkBadge {
                            text: "SECURE";
                            tint: Ck.mint;
                            dot: true;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 28px;

            CkPrimaryButton {
                text: "Ro'yxatdan o'tish";
                icon: CkIcons.arrow-r;
                clicked => {
                    root.register();
                }
            }
        }
    }
}
