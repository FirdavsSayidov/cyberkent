// ═══════════════════════════════════════════════════════════════════════════
// CYBERKENT — UMUMIY DIZAYN TIZIMI
//
// Sof Slint. Barcha sahifa shu fayldan import qiladi.
// Manba: CyberKent_1/design-tokens.css va components.jsx
// ═══════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────
// Tokenlar — design-tokens.css'ning :root bloki
// ───────────────────────────────────────────────────────────────────────────

export global Ck {
    // Brend
    out property <color> cyan: #00e5ff;
    out property <color> purple: #7c4dff;
    out property <color> magenta: #ff2d95;
    out property <color> mint: #5bffc2;
    out property <color> amber: #ffb547;
    out property <color> danger: #ff5577;
    out property <color> lilac: #b8a4ff;  // badge-purple matni

    // Sirtlar
    out property <color> bg0: #06060f;  // sahifa
    out property <color> bg1: #0a0a18;  // 1-daraja karta
    out property <color> bg2: #11122a;  // 2-daraja karta
    out property <color> bg3: #1a1c3a;  // ko'tarilgan

    // Chiziqlar (CSS'da rgba(124,77,255,.18) va .38)
    out property <color> line: #7c4dff2e;
    out property <color> line-strong: #7c4dff61;

    // Matn
    out property <color> text: #eef0ff;
    out property <color> text-dim: #8b8ec2;
    out property <color> text-mute: #565a87;

    // Shriftlar. Qurilmada bo'lmasa Slint tizim shriftiga tushadi.
    out property <string> sans: "Space Grotesk";
    out property <string> mono: "JetBrains Mono";

    // Radiuslar
    out property <length> r-sm: 10px;
    out property <length> r-md: 16px;
    out property <length> r-lg: 22px;

    // ── XAVFSIZ ZONA ──────────────────────────────────────────────────────
    // Android oynani butun ekranga ochadi — status bar va navigatsiya paneli
    // tagida ham. Slint tilida tizim insets'ini o'qish yo'q, shuning uchun
    // qiymatlar shu yerda turadi (SM-A155F: 450dpi, 384×832dp).
    // Boshqa telefonda chegara boshqacha bo'lsa — shu ikki sonni o'zgartirish
    // kifoya. Desktop'da 0 qo'ysa bo'ladi.
    out property <length> safe-top: 30px;
    out property <length> safe-bottom: 48px;

    // Suzuvchi tab paneli egallagan joy (60px panel + 20px chet + 20px havo)
    out property <length> tabbar-space: 100px;
    // Panelning ekran pastidan chekinishi
    out property <length> tabbar-gap: 20px;
    // Aylanadigan qism shu yerda tugaydi: aynan panelning pastki chetida.
    // Shunda kontent panel ostiga kirib ketadi, lekin uning pastidan
    // ko'rinmaydi.
    out property <length> content-bottom: 68px;
}

// ───────────────────────────────────────────────────────────────────────────
// Ikonkalar — components.jsx'dagi SVG `d` qiymatlari.
// <rect> va <circle> path buyruqlariga o'girildi, chunki Slint faqat path
// commands'ni tushunadi. Barchasi 24×24 viewbox'da.
// ───────────────────────────────────────────────────────────────────────────

