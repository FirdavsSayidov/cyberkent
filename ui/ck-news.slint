// ═══════════════════════════════════════════════════════════════════════════
// YANGILIKLAR / BILDIRISHNOMALAR / JADVAL — Flutter bilan 1:1.
//
// NewsPage: TopBar (YANGILIKLAR / Cyber News) → chiplar (BARCHASI/EVENT/
// BONUS/SHOP) → featured karta (katta rasm + TOP/EVENT badge + nom + sana) →
// kichik kartalar (rasm + badge + nom + sana).
//
// NotificationsPage: NavBar (MARKAZ / Bildirishnomalar) → qatorlar:
// qo'ng'iroq ikon + badge (EVENT/BONUS/SHOP) + nom + sana.
//
// SchedulePage: NavBar (JADVAL · TIMELINE / Tadbir jadvali) + "Cyber Summit
// 2024" → vaqt chizig'i: soat (mono) + nuqta + karta (nom + MAIN badge + joy).
// ═══════════════════════════════════════════════════════════════════════════

import {
    Ck, CkIcons,
    CkIcon, CkIconSlot, CkIconButton, CkBadge, CkChip,
    CkCard, CkCardFlat, CkImage, CkNavBar, CkScroll, CkTopBar,
} from "ck-common.slint";

export struct CkNewsItem {
    tag: string,
    tag-tint: color,
    title: string,
    date: string,
    featured: bool,
    bga: color,
    bgb: color,
}

export struct CkNotif {
    tag: string,
    title: string,
    date: string,
    tint: color,
}

export struct CkScheduleItem {
    time: string,
    title: string,
    place: string,
    tag: string,
    done: bool,
}

// ── YANGILIKLAR ─────────────────────────────────────────────────────────────

export component NewsPage inherits Rectangle {
    background: transparent;

    in property <[string]> filters: ["BARCHASI", "EVENT", "BONUS", "SHOP"];

    in property <[CkNewsItem]> items: [
        {
            tag: "EVENT", tag-tint: #b8a4ff, title: "Cyberkent 2026 ochildi!",
            date: "7 iyl · 16:09", featured: true, bga: #5a2242, bgb: #241035,
        },
        {
            tag: "BONUS", tag-tint: #00e5ff, title: "Cyber Quiz bonuslari",
            date: "7 iyl · 15:09", featured: false, bga: #2a2a5a, bgb: #14143a,
        },
        {
            tag: "SHOP", tag-tint: #00e5ff, title: "Yangi do'kon mahsulotlari",
            date: "7 iyl · 14:09", featured: false, bga: #2a2a5a, bgb: #14143a,
        },
    ];

    property <int> chip: 0;

    callback back();

    VerticalLayout {
        padding-top: Ck.safe-top;

        CkNavBar {
            eyebrow: "YANGILIKLAR";
            title: "Cyber News";
            back => {
                root.back();
            }
        }

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 12px;
            spacing: 8px;
            alignment: start;

            for f[i] in root.filters: CkChip {
                text: f;
                active: root.chip == i;
                clicked => {
                    root.chip = i;
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: list.preferred-height;

            list := VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: 20px;
                padding-right: 20px;
                padding-bottom: 30px;
                spacing: 14px;

                for n[i] in root.items: CkCard {
                    interactive: false;

                    VerticalLayout {
                        // Featured: katta rasm usti; oddiy: qator.
                        if n.featured: VerticalLayout {
                            spacing: 0px;

                            Rectangle {
                                height: 200px;
                                border-top-left-radius: Ck.r-lg;
                                border-top-right-radius: Ck.r-lg;
                                background: @linear-gradient(150deg, n.bga, n.bgb);
                                clip: true;

                                Rectangle {
                                    x: 40px;
                                    y: 24px;
                                    width: 70px;
                                    height: 70px;
                                    border-radius: 35px;
                                    background: @radial-gradient(circle, #ffffff1c 0%, #00000000 70%);
                                }

                                HorizontalLayout {
                                    x: 18px;
                                    y: parent.height - 44px;
                                    height: 28px;
                                    spacing: 8px;

                                    CkBadge {
                                        text: "TOP";
                                        tint: Ck.magenta;
                                    }

                                    CkBadge {
                                        text: n.tag;
                                        tint: n.tag-tint;
                                    }

                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }

                            VerticalLayout {
                                padding: 18px;
                                spacing: 6px;

                                Text {
                                    text: n.title;
                                    color: Ck.text;
                                    font-family: Ck.sans;
                                    font-size: 20px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: n.date;
                                    color: Ck.text-dim;
                                    font-family: Ck.sans;
                                    font-size: 14px;
                                }
                            }
                        }

                        if !n.featured: HorizontalLayout {
                            padding: 14px;
                            spacing: 14px;

                            Rectangle {
                                width: 76px;
                                height: 76px;
                                border-radius: 14px;
                                background: @linear-gradient(150deg, n.bga, n.bgb);

                                Rectangle {
                                    x: 12px;
                                    y: 8px;
                                    width: 30px;
                                    height: 30px;
                                    border-radius: 15px;
                                    background: @radial-gradient(circle, #ffffff1c 0%, #00000000 70%);
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 6px;

                                HorizontalLayout {
                                    alignment: start;
                                    CkBadge {
                                        text: n.tag;
                                        tint: n.tag-tint;
                                    }
                                }

                                Text {
                                    text: n.title;
                                    color: Ck.text;
                                    font-family: Ck.sans;
                                    font-size: 16px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: n.date;
                                    color: Ck.text-dim;
                                    font-family: Ck.sans;
                                    font-size: 13px;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── BILDIRISHNOMALAR ────────────────────────────────────────────────────────

export component NotificationsPage inherits Rectangle {
    background: transparent;

    in property <[CkNotif]> items: [
        { tag: "EVENT", title: "Cyberkent 2026 ochildi!", date: "7 iyl · 16:09", tint: #b8a4ff },
        { tag: "BONUS", title: "Cyber Quiz bonuslari", date: "7 iyl · 15:09", tint: #00e5ff },
        { tag: "SHOP", title: "Yangi do'kon mahsulotlari", date: "7 iyl · 14:09", tint: #00e5ff },
    ];

    callback back();

    VerticalLayout {
        padding-top: Ck.safe-top;

        CkNavBar {
            eyebrow: "MARKAZ";
            title: "Bildirishnomalar";
            back => {
                root.back();
            }
        }

        Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: list.preferred-height;

            list := VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: 20px;
                padding-right: 20px;
                padding-bottom: 30px;
                spacing: 12px;

                for n in root.items: CkCardFlat {
                    interactive: false;

                    HorizontalLayout {
                        padding: 16px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 14px;
                                background: Ck.bg2;
                                border-width: 1px;
                                border-color: Ck.line;

                                CkIcon {
                                    commands: CkIcons.bell;
                                    size: 19px;
                                    tint: Ck.text-dim;
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;

                            HorizontalLayout {
                                alignment: start;
                                CkBadge {
                                    text: n.tag;
                                    tint: n.tint;
                                }
                            }

                            Text {
                                text: n.title;
                                color: Ck.text;
                                font-family: Ck.sans;
                                font-size: 16px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }

                            Text {
                                text: n.date;
                                color: Ck.text-dim;
                                font-family: Ck.sans;
                                font-size: 13px;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ── JADVAL ──────────────────────────────────────────────────────────────────

export component SchedulePage inherits Rectangle {
    background: transparent;

    in property <string> event-name: "Cyber Summit 2024";

    in property <[CkScheduleItem]> items: [
        { time: "16:09", title: "Ochilish marosimi", place: "Main Stage", tag: "MAIN", done: true },
        { time: "18:09", title: "Cyber Quiz", place: "Quiz Zone", tag: "MAIN", done: true },
        { time: "20:09", title: "CTF musobaqasi", place: "Arena", tag: "MAIN", done: true },
        { time: "23:09", title: "Yopilish + sovrinlar", place: "Main Stage", tag: "MAIN", done: true },
    ];

    callback back();

    VerticalLayout {
        padding-top: Ck.safe-top;

        CkNavBar {
            eyebrow: "JADVAL · TIMELINE";
            title: "Tadbir jadvali";
            back => {
                root.back();
            }
        }

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 10px;

            Text {
                text: root.event-name;
                color: Ck.text-dim;
                font-family: Ck.sans;
                font-size: 14px;
            }
        }

        Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: list.preferred-height;

            list := VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: 20px;
                padding-right: 20px;
                padding-bottom: 30px;

                for it[i] in root.items: HorizontalLayout {
                    spacing: 14px;

                    // Vaqt.
                    VerticalLayout {
                        width: 52px;
                        padding-top: 12px;
                        Text {
                            text: it.time;
                            color: Ck.text-dim;
                            font-family: Ck.mono;
                            font-size: 13px;
                            horizontal-alignment: right;
                        }
                    }

                    // Chiziq + nuqta.
                    Rectangle {
                        width: 20px;

                        if i != root.items.length - 1: Rectangle {
                            x: 9px;
                            y: 22px;
                            width: 2px;
                            height: parent.height - 18px;
                            background: Ck.line-strong;
                        }

                        Rectangle {
                            x: 2px;
                            y: 12px;
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: Ck.mint;
                            background: Ck.bg0;

                            if it.done: CkIcon {
                                commands: CkIcons.check;
                                size: 9px;
                                tint: Ck.mint;
                            }
                        }
                    }

                    // Karta.
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding-bottom: 14px;

                        CkCardFlat {
                            interactive: false;

                            HorizontalLayout {
                                padding: 14px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        border-radius: 11px;
                                        background: Ck.mint.transparentize(0.88);

                                        CkIcon {
                                            commands: i == 0 ? CkIcons.qr : (i == 1 ? CkIcons.bolt : (i == 2 ? CkIcons.game : CkIcons.users));
                                            size: 17px;
                                            tint: Ck.mint;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 3px;

                                    Text {
                                        text: it.title;
                                        color: Ck.text;
                                        font-family: Ck.sans;
                                        font-size: 15px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: it.place;
                                        color: Ck.text-dim;
                                        font-family: Ck.sans;
                                        font-size: 13px;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    CkBadge {
                                        text: it.tag;
                                        tint: Ck.cyan;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
