// ═══════════════════════════════════════════════════════════════════════════
// BOSH SAHIFA — Flutter `user/home_screen.dart` bilan 1:1.
//
// Tartib: sarlavha (avatar + salom + qo'ng'iroq) → hamyon hero kartasi
// (balans, +hafta, "Mening QR" va "Do'kon" tugmalari) → 4 tezkor amal →
// "Hozir jonli efirda" → "Yaqinlashayotgan tadbirlar" (3 tagacha).
// ═══════════════════════════════════════════════════════════════════════════

import {
    Ck, CkIcons, CkAction,
    CkIcon, CkIconSlot, CkIconButton, CkAvatar, CkBadge,
    CkHoloCoin, CkCoin, CkHeroCard, CkCard, CkImage,
    CkGlassButton, CkSectionHead, CkScroll,
} from "ck-common.slint";

export struct CkHomeEvent {
    day: string,
    month: string,
    tag: string,
    title: string,
    sub: string,
    bga: color,
    bgb: color,
}

export component HomePage inherits Rectangle {
    // Qobiq ichida butun joyni egallaydi; fon qobiqda chiziladi.
    background: transparent;

    // Sahifa ochiqmi. Faqat animatsiyalarni boshqarish uchun — boshqa tabda
    // turganda LIVE nuqtasi ishlab, ekranni behuda qayta chizmasin.
    in property <bool> active: true;

    in property <string> user-name: "Aziz Karimov";
    in property <string> user-initials: "AK";
    in property <bool> has-notification: true;

    in property <string> balance: "155";
    in property <string> balance-delta-pre: "+275";
    in property <string> balance-delta-post: " BU HAFTA";

    in property <string> live-title: "Frontend Hackathon · Final";
    in property <string> live-sub: "CK Studio · 16:09";
    in property <string> live-viewers: "2,841 KO'RUVCHI";

    // Flutter: 4 ta tezkor amal — Tadbirlar/O'yinlar/Topshiriq/Stream.
    in property <[CkAction]> actions: [
        { icon: CkIcons.ticket, label: "Tadbirlar", tint: #00e5ff },
        { icon: CkIcons.game, label: "O'yinlar", tint: #ff2d95 },
        { icon: CkIcons.trophy, label: "Topshiriq", tint: #5bffc2 },
        { icon: CkIcons.stream, label: "Stream", tint: #ffb547 },
    ];

    // Flutter: eng ko'pi 3 ta kelgusi tadbir.
    in property <[CkHomeEvent]> events: [
        {
            day: "7", month: "OKT", tag: "TAQDIMOT",
            title: "Ochilish marosimi", sub: "Asosiy sahna · 14:10",
            bga: #2a1a5a, bgb: #0f1d4a,
        },
        {
            day: "7", month: "OKT", tag: "CYBER QUIZ",
            title: "Cyber Quiz: 1-tur", sub: "Quiz zonasi · 15:10",
            bga: #4a1a5a, bgb: #1d0f4a,
        },
        {
            day: "7", month: "OKT", tag: "MUSOBAQA",
            title: "CTF musobaqasi", sub: "Arena · 20:09",
            bga: #0f3a4a, bgb: #10204a,
        },
    ];

    callback notifications-clicked();
    callback qr-clicked();
    callback shop-clicked();
    callback action-clicked(index: int);
    callback live-clicked();
    callback live-all-clicked();
    callback event-clicked(index: int);
    callback events-all-clicked();
    callback profile-clicked();

    CkScroll {
        // ── SARLAVHA ────────────────────────────────────────────────────
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 6px;
            spacing: 12px;

            // Avatar + ism bosilganda profilga o'tadi (Flutter'dagidek).
            Rectangle {
                horizontal-stretch: 1;

                TouchArea {
                    clicked => {
                        root.profile-clicked();
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        CkAvatar {
                            size: 44px;
                            initials: root.user-initials;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: "Assalomu alaykum";
                            color: Ck.text-dim;
                            font-family: Ck.sans;
                            font-size: 12px;
                        }

                        Text {
                            text: root.user-name;
                            color: Ck.text;
                            font-family: Ck.sans;
                            font-size: 15px;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                CkIconButton {
                    icon: CkIcons.bell;
                    size: 38px;
                    icon-size: 18px;
                    clicked => {
                        root.notifications-clicked();
                    }

                    // o'qilmagan xabar nuqtasi
                    if root.has-notification: Rectangle {
                        x: parent.width - self.width - 7px;
                        y: 7px;
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        border-width: 2px;
                        border-color: Ck.bg2;
                        background: Ck.danger;
                    }
                }
            }
        }

        // ── HAMYON HERO KARTASI ─────────────────────────────────────────
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 8px;

            CkHeroCard {
                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            spacing: 2px;

                            Text {
                                text: "CYBERAQCHA · BALANS";
                                color: Ck.cyan;
                                font-family: Ck.mono;
                                font-size: 10px;
                                letter-spacing: 1.8px;
                            }

                            HorizontalLayout {
                                padding-top: 6px;
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: root.balance;
                                    color: Ck.text;
                                    font-family: Ck.sans;
                                    font-size: 32px;
                                    font-weight: 700;
                                }

                                VerticalLayout {
                                    alignment: end;
                                    padding-bottom: 7px;

                                    CkCoin {
                                        size: 22px;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 3px;
                                alignment: start;
                                Text {
                                    text: root.balance-delta-pre;
                                    color: Ck.text-mute;
                                    font-family: Ck.mono;
                                    font-size: 10px;
                                    letter-spacing: 1.2px;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    CkCoin { size: 11px; }
                                }
                                Text {
                                    text: root.balance-delta-post;
                                    color: Ck.text-mute;
                                    font-family: Ck.mono;
                                    font-size: 10px;
                                    letter-spacing: 1.2px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: start;
                            CkHoloCoin {
                                size: 64px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        CkGlassButton {
                            horizontal-stretch: 1;
                            icon: CkIcons.qr;
                            text: "Mening QR";
                            clicked => {
                                root.qr-clicked();
                            }
                        }

                        CkGlassButton {
                            horizontal-stretch: 1;
                            icon: CkIcons.shop;
                            text: "Do'kon";
                            clicked => {
                                root.shop-clicked();
                            }
                        }
                    }
                }
            }
        }

        // ── TEZKOR AMALLAR ──────────────────────────────────────────────
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            spacing: 8px;

            for act[index] in root.actions: Rectangle {
                horizontal-stretch: 1;
                height: 78px;
                border-radius: Ck.r-md;
                border-width: 1px;
                border-color: Ck.line;
                background: act-touch.pressed ? Ck.bg3 : Ck.bg2;
                animate background { duration: 120ms; }

                act-touch := TouchArea {
                    clicked => {
                        root.action-clicked(index);
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 10px;
                            background: act.tint.transparentize(0.88);

                            CkIcon {
                                commands: act.icon;
                                size: 18px;
                                tint: act.tint;
                            }
                        }
                    }

                    Text {
                        text: act.label;
                        color: Ck.text-dim;
                        font-family: Ck.mono;
                        font-size: 10px;
                        letter-spacing: 0.8px;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // ── JONLI EFIR ──────────────────────────────────────────────────
        CkSectionHead {
            title: "Hozir jonli efirda";
            action: "BARCHASI";
            action-clicked => {
                root.live-all-clicked();
            }
        }

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;

            Rectangle {
                height: 140px;
                border-radius: 18px;
                background: @linear-gradient(135deg, #2a1a5a, #0f1d4a);
                clip: true;

                live-touch := TouchArea {
                    clicked => {
                        root.live-clicked();
                    }
                }

                // rangli dog'lar
                Rectangle {
                    x: parent.width * 0.3 - self.width / 2;
                    y: parent.height * 0.4 - self.height / 2;
                    width: parent.width * 0.9;
                    height: self.width;
                    background: @radial-gradient(circle, Ck.magenta.transparentize(0.5) 0%, #00000000 62%);
                }

                Rectangle {
                    x: parent.width * 0.8 - self.width / 2;
                    y: parent.height * 0.8 - self.height / 2;
                    width: parent.width * 0.9;
                    height: self.width;
                    background: @radial-gradient(circle, Ck.cyan.transparentize(0.5) 0%, #00000000 62%);
                }

                // yorliqlar
                HorizontalLayout {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: 22px;
                    spacing: 6px;

                    CkBadge {
                        text: "JONLI";
                        tint: Ck.danger;
                        live: true;
                        live-running: root.active;
                    }

                    CkBadge {
                        text: root.live-viewers;
                        tint: Ck.text-dim;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                // o'rtadagi play tugmasi
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: live-touch.pressed ? #ffffff : #ffffffeb;

                    CkIcon {
                        commands: CkIcons.play;
                        size: 26px;
                        tint: Ck.bg1;
                        filled: true;
                    }
                }

                // pastdagi matn
                VerticalLayout {
                    x: 14px;
                    y: parent.height - self.height - 14px;
                    width: parent.width - 28px;
                    height: self.preferred-height;
                    spacing: 2px;

                    Text {
                        text: root.live-title;
                        color: #ffffff;
                        font-family: Ck.sans;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: root.live-sub;
                        color: Ck.text-dim;
                        font-family: Ck.sans;
                        font-size: 12px;
                    }
                }
            }
        }

        // ── YAQINLASHAYOTGAN TADBIRLAR ──────────────────────────────────
        CkSectionHead {
            title: "Yaqinlashayotgan tadbirlar";
            action: "BARCHASI";
            action-clicked => {
                root.events-all-clicked();
            }
        }

        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 10px;

            for ev[index] in root.events: CkCard {
                clicked => {
                    root.event-clicked(index);
                }

                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;

                    // sana katakchasi
                    CkImage {
                        width: 64px;
                        height: 64px;
                        radius: 14px;
                        bga: ev.bga;
                        bgb: ev.bgb;

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;

                            Text {
                                text: ev.day;
                                color: #ffffff;
                                font-family: Ck.sans;
                                font-size: 22px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: ev.month;
                                color: #ffffffcc;
                                font-family: Ck.mono;
                                font-size: 9px;
                                letter-spacing: 1.4px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: start;

                            CkBadge {
                                text: ev.tag;
                                tint: Ck.lilac;
                            }
                        }

                        Text {
                            text: ev.title;
                            color: Ck.text;
                            font-family: Ck.sans;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: ev.sub;
                            color: Ck.text-dim;
                            font-family: Ck.sans;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        CkIconSlot {
                            commands: CkIcons.chev-r;
                            size: 16px;
                            tint: Ck.text-mute;
                        }
                    }
                }
            }
        }
    }
}
