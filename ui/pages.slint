// ═══════════════════════════════════════════════════════════════════════════
// SOF SLINT SAHIFALAR — bu faylda bitta ham Rust satri yo'q.
//
// Butun holat shu yerda `property` sifatida yashaydi: qaysi sahifa ochiq,
// hisoblagich qiymati, shakl maydonlari. Rust hech narsa qilmaydi.
//
// Ko'rish uchun:  Cmd+Shift+P  →  "Slint: Show Preview"
// (yoki tahrirlagichning yuqori o'ng burchagidagi ▷ belgisi)
// ═══════════════════════════════════════════════════════════════════════════

import { Button, ComboBox, LineEdit, Palette, Slider, Switch } from "std-widgets.slint";

// ───────────────────────────────────────────────────────────────────────────
// Qayta ishlatiladigan mayda bo'laklar
// ───────────────────────────────────────────────────────────────────────────

// Chap paneldagi menyu tugmasi. std-widgets'da bunday tugma yo'q — o'zimiz
// Rectangle + TouchArea'dan yasaymiz.
component NavButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;

    callback clicked();

    height: 40px;
    border-radius: 8px;
    background: root.active
        ? Palette.alternate-background
        : touch.has-hover
            ? Palette.alternate-background.transparentize(0.55)
            : transparent;
    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        spacing: 9px;

        Text {
            text: root.icon;
            font-size: 15px;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            font-size: 14px;
            font-weight: root.active ? 700 : 400;
            color: Palette.foreground;
            vertical-alignment: center;
        }
    }
}

// Har bir sahifaning yuqori qismi.
component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;

    spacing: 5px;

    Text {
        text: root.title;
        font-size: 24px;
        font-weight: 800;
        color: Palette.foreground;
    }

    Text {
        text: root.subtitle;
        font-size: 13px;
        wrap: word-wrap;
        color: Palette.foreground.transparentize(0.45);
    }
}

// Ramkali quti. Ichiga qo'yilgan layout uni to'ldiradi, quti o'lchami esa
// ichidagi mazmundan kelib chiqadi.
component Card inherits Rectangle {
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.alternate-background.transparentize(0.5);
}

// ───────────────────────────────────────────────────────────────────────────
// 1-sahifa
// ───────────────────────────────────────────────────────────────────────────

component HomePage inherits VerticalLayout {
    spacing: 18px;

    PageHeader {
        title: "Sof Slint sahifalar";
        subtitle: "Chapdagi menyu, hisoblagich va shakl — hammasi .slint ichida yozilgan. src/main.rs bu faylni ko'rmaydi ham.";
    }

    Card {
        VerticalLayout {
            padding: 18px;
            spacing: 9px;

            Text {
                text: "Slint tili o'zi nima qila oladi";
                font-size: 15px;
                font-weight: 700;
            }

            Text { text: "•  property — holatni saqlash va o'zgartirish"; font-size: 13px; }
            Text { text: "•  callback — komponentlar orasida xabar uzatish"; font-size: 13px; }
            Text { text: "•  if / for — sahifa va ro'yxatlarni shartli qurish"; font-size: 13px; }
            Text { text: "•  animate — o'tishlarni yumshatish"; font-size: 13px; }
            Text { text: "•  <=> — ikki tomonlama bog'lanish"; font-size: 13px; }
        }
    }

    Card {
        VerticalLayout {
            padding: 18px;
            spacing: 12px;

            Text {
                text: "Animatsiya ham shu yerda";
                font-size: 15px;
                font-weight: 700;
            }

            Rectangle {
                height: 52px;

                ball := Rectangle {
                    y: 4px;
                    // x qiymati hover'ga bog'langan, `animate` esa o'tishni
                    // silliqlaydi — hech qanday timer yoki kod kerak emas.
                    x: hover.has-hover ? parent.width - self.width : 0;
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: Palette.accent-background;
                    animate x { duration: 450ms; easing: ease-in-out; }
                }

                hover := TouchArea { }
            }

            Text {
                text: "Ustiga sichqonchani olib boring.";
                font-size: 12px;
                color: Palette.foreground.transparentize(0.5);
            }
        }
    }

    // Qolgan bo'sh joyni egallab, kartochkalarni yuqoriga suradi.
    Rectangle {
        vertical-stretch: 1;
    }
}

// ───────────────────────────────────────────────────────────────────────────
// 2-sahifa — hisoblagich.
// Qiymatlar `in-out property`: ular tashqaridan (root'dan) bog'lanadi, shuning
// uchun sahifa almashganda ham yo'qolmaydi. Sababi pastda izohlangan.
// ───────────────────────────────────────────────────────────────────────────

component CounterPage inherits VerticalLayout {
    in-out property <int> count;
    in-out property <int> step;

    spacing: 18px;

    PageHeader {
        title: "Hisoblagich";
        subtitle: "Tugmalar bevosita property'ni o'zgartiradi: count += step. Ekran o'zi qayta chiziladi.";
    }

    Card {
        VerticalLayout {
            padding: 20px;
            spacing: 18px;

            Text {
                text: "\{root.count}";
                font-size: 56px;
                font-weight: 300;
                horizontal-alignment: center;
                color: root.count < 0 ? #e5484d : Palette.foreground;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Button {
                    text: "− \{root.step}";
                    clicked => {
                        root.count -= root.step;
                    }
                }

                Button {
                    text: "+ \{root.step}";
                    primary: true;
                    clicked => {
                        root.count += root.step;
                    }
                }

                Button {
                    text: "Nol";
                    enabled: root.count != 0;
                    clicked => {
                        root.count = 0;
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "qadam:";
                    font-size: 13px;
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(0.45);
                }

                // `for` massiv bo'ylab yuradi — uch dona tugma qo'lda yozilmaydi.
                for s in [1, 5, 10]: Rectangle {
                    width: 40px;
                    height: 28px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.step == s ? Palette.accent-background : Palette.border;
                    background: root.step == s ? Palette.accent-background : transparent;

                    Text {
                        text: "\{s}";
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: root.step == s ? Palette.accent-foreground : Palette.foreground;
                    }

                    TouchArea {
                        clicked => {
                            root.step = s;
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }
}

// ───────────────────────────────────────────────────────────────────────────
// 3-sahifa — shakl.
// Bu sahifaning holati widget'larning o'zida (name-input.text va h.k.).
// Sahifa almashganda `if` uni o'chirib tashlaydi, shuning uchun kiritilgan
// ma'lumot yo'qoladi. Saqlanishi kerak bo'lsa — hisoblagichdagidek root'ga
// ko'tarish kerak.
// ───────────────────────────────────────────────────────────────────────────

component FormPage inherits VerticalLayout {
    spacing: 18px;

    PageHeader {
        title: "Shakl";
        subtitle: "O'ngdagi kartochka to'g'ridan-to'g'ri maydonlarga bog'langan. Yozib ko'ring — darhol o'zgaradi.";
    }

    HorizontalLayout {
        spacing: 18px;

        // ── maydonlar ──
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 10px;

            Text {
                text: "Ism";
                font-size: 12px;
                color: Palette.foreground.transparentize(0.45);
            }

            name-input := LineEdit {
                placeholder-text: "Ismingiz";
            }

            Text {
                text: "Email";
                font-size: 12px;
                color: Palette.foreground.transparentize(0.45);
            }

            mail-input := LineEdit {
                placeholder-text: "siz@misol.uz";
            }

            Text {
                text: "Tarif";
                font-size: 12px;
                color: Palette.foreground.transparentize(0.45);
            }

            plan := ComboBox {
                model: ["Bepul", "Pro", "Jamoa"];
            }

            notify := Switch {
                text: "Xabarnomalar";
                checked: true;
            }

            HorizontalLayout {
                spacing: 10px;

                Text {
                    text: "Yorqinlik";
                    font-size: 12px;
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(0.45);
                }

                bright := Slider {
                    minimum: 0;
                    maximum: 100;
                    value: 70;
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        // ── tirik kartochka: hamma qiymat bog'lanish orqali keladi ──
        Card {
            width: 210px;

            VerticalLayout {
                padding: 16px;
                spacing: 9px;

                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: Palette.accent-background;

                    Text {
                        text: "👤";
                        font-size: 22px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: name-input.text == "" ? "Ismsiz" : name-input.text;
                    font-size: 16px;
                    font-weight: 700;
                    overflow: elide;
                }

                Text {
                    text: mail-input.text == "" ? "email kiritilmagan" : mail-input.text;
                    font-size: 12px;
                    overflow: elide;
                    color: Palette.foreground.transparentize(0.45);
                }

                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }

                Text { text: "Tarif:  \{plan.current-value}"; font-size: 12px; }
                Text {
                    text: notify.checked ? "Xabarnomalar:  yoniq" : "Xabarnomalar:  o'chiq";
                    font-size: 12px;
                }
                Text { text: "Yorqinlik:  \{round(bright.value)}%"; font-size: 12px; }

                Rectangle {
                    vertical-stretch: 1;
                }

                // Slider qiymatini ko'rsatuvchi chizg'ich.
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Palette.border;

                    Rectangle {
                        x: 0;
                        width: parent.width * bright.value / 100;
                        height: 100%;
                        border-radius: 3px;
                        background: Palette.accent-background;
                    }
                }
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// Asosiy oyna — navigatsiya
// ───────────────────────────────────────────────────────────────────────────

export component PagesWindow inherits Window {
    title: "Slint sahifalar";
    preferred-width: 780px;
    preferred-height: 580px;
    min-width: 640px;
    min-height: 460px;
    background: Palette.background;

    // Butun navigatsiya — bitta butun son. Boshqa hech narsa kerak emas.
    property <int> current: 0;

    // Hisoblagich holati bu yerda turadi, sahifada emas — pastdagi `if`
    // sahifani o'chirib tashlaganda ham qiymat saqlanib qolsin.
    property <int> count: 0;
    property <int> step: 1;

    HorizontalLayout {

        // ── chap panel ──
        Rectangle {
            width: 190px;
            background: Palette.alternate-background.transparentize(0.7);

            // Faol sahifani ko'rsatuvchi chizgi. y qiymati current'dan
            // hisoblanadi: padding 12px + har bir tugma 40px + oraliq 6px.
            Rectangle {
                x: 0;
                y: 12px + root.current * 46px;
                width: 3px;
                height: 40px;
                border-radius: 2px;
                background: Palette.accent-background;
                animate y {
                    duration: 220ms;
                    easing: ease-out;
                }
            }

            VerticalLayout {
                padding: 12px;
                padding-left: 14px;
                spacing: 6px;
                alignment: start;

                NavButton {
                    icon: "🏠";
                    label: "Boshlash";
                    active: root.current == 0;
                    clicked => {
                        root.current = 0;
                    }
                }

                NavButton {
                    icon: "🔢";
                    label: "Hisoblagich";
                    active: root.current == 1;
                    clicked => {
                        root.current = 1;
                    }
                }

                NavButton {
                    icon: "📝";
                    label: "Shakl";
                    active: root.current == 2;
                    clicked => {
                        root.current = 2;
                    }
                }
            }
        }

        // ── o'ng tomon: ochiq sahifa ──
        Rectangle {
            horizontal-stretch: 1;

            VerticalLayout {
                padding: 24px;

                if root.current == 0: HomePage { }

                if root.current == 1: CounterPage {
                    count <=> root.count;
                    step <=> root.step;
                }

                if root.current == 2: FormPage { }
            }
        }
    }
}
